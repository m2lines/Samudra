[Unit]
Description=Samudra OM4 data viewer

[Service]
Type=exec
WorkingDirectory=%h/services/om4-viewer/apps/om4_viewer
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/services/om4-viewer/apps/om4_viewer/.venv/bin/python3 %h/services/om4-viewer/apps/om4_viewer/server.py --data %h/data/om4_onedeg --local-rollout %h/data/samudra-native-gate-ema/viewer.zarr --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
