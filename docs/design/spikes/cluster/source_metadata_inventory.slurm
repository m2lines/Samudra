#SBATCH --job-name=llc-source-metadata
#SBATCH --partition=mit_quicktest
#SBATCH --time=00:10:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G

set -euo pipefail
spike_root=/orcd/scratch/orcd/008/merose/llc_sharding_spikes_20260903
"$spike_root/env/bin/python" "$spike_root/scripts/source_metadata_inventory.py" \
  /orcd/data/abodner/003/LLC4320/LLC4320 \
  > "$spike_root/results/source-metadata-inventory.json"
