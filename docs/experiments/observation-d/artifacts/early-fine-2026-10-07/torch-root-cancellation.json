    "scripts": {
      "profile-early-fine.py": {
        "sha256": "3c57bffa3e790f39b7a75ad0a8140067464247f93a891cf2fe74f7ffee7de02d",
        "source": "import argparse,cProfile,json,os,pathlib,pstats,time,collections,torch\nfrom samudra.experiments.early_fine_training import EarlyPilot\nfrom samudra.experiments.early_fine_data import EarlySamples\nfrom samudra.experiments.observation_training import Samples\n# The launcher makes /scratch read-only and overlays this path with a verified\n# independent copy. Production files are never writable inside this container.\narm=pathlib.Path(os.environ['PROFILE_ARM'])\nargs=argparse.Namespace(**json.loads((arm/'manifest.json').read_text())['arguments'])\npilot=EarlyPilot(args)\ncounts=collections.defaultdict(list)\ndef wrap(cls,name):\n orig=getattr(cls,name)\n def timed(*a,**kw):\n  torch.cuda.synchronize(); start=time.monotonic()\n  try:return orig(*a,**kw)\n  finally:\n   torch.cuda.synchronize();counts[cls.__name__+'.'+name].append(time.monotonic()-start)\n setattr(cls,name,timed)\nwrap(EarlySamples,'sample');wrap(Samples,'load')\nprof=cProfile.Profile();prof.enable();start=time.monotonic();first=pilot.completed\nfor i in range(24):pilot.train_update()\ntorch.cuda.synchronize();elapsed=time.monotonic()-start;prof.disable()\nprof.dump_stats(str(arm/'profile.pstats'))\nwith (arm/'profile.txt').open('w') as f:pstats.Stats(prof,stream=f).sort_stats('cumulative').print_stats(65)\nresult={'start_step':first,'end_step':pilot.completed,'seconds':elapsed,'timings':pilot.timings,'calls':{k:{'n':len(v),'total':sum(v),'mean':sum(v)/len(v)} for k,v in counts.items()},'producer':os.environ['SAMUDRA_CODE_COMMIT']}\n(arm/'PROFILE_COMPLETE.json').write_text(json.dumps(result,indent=2)+'\\n');print(json.dumps(result),flush=True)\nif pilot.wandb:pilot.wandb.finish()\n"
      },
      "profile-early-fine.sbatch": {
        "sha256": "e7765e9e255ab7344e2ab04b4e8d9d3c747e2b911d4af2f7157d170eaede065c",
        "source": "#!/bin/bash -l\nset -euo pipefail\nroot=/scratch/jr7309/runs/2026-10-08-early-fine-rtx/recovery-replay\ncode=$root/source/030c96ec7205ab87f38f9cdf132d07a282db7602\nexport SAMUDRA_CODE_COMMIT=030c96ec7205ab87f38f9cdf132d07a282db7602\nexport SAMUDRA_RUNTIME_SHA256=$(sha256sum \"$root/runtime-contract.json\" | cut -d ' ' -f1)\nexport OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1\nexport PROFILE_ARM=$root/U-multitask-early-fine-latent\nimage=/scratch/jr7309/.apptainer-images/ghcr.io-m2lines-ocean-emulator-physicsnemo-26.05-9cd36b1bdcf4921fb027494afa4157e217818ccd.sif\nprintf 'local tmp: %s\\n' \"${SLURM_TMPDIR:-unset}\"\ndf -hT /tmp \"${SLURM_TMPDIR:-/tmp}\"\nnvidia-smi --query-gpu=timestamp,index,utilization.gpu,memory.used --format=csv -l 1 > \"$root/diagnostic-io/gpu-$SLURM_JOB_ID.csv\" &\ntelemetry=$!\ntrap 'kill \"$telemetry\" 2>/dev/null || true' EXIT\n# RO scratch prevents accidental production writes; only the independent copy is RW.\nsrun apptainer exec --nv --bind \"$code:/pilot-code:ro,/scratch:/scratch:ro,$root/diagnostic-io/arm:$PROFILE_ARM:rw\" \"$image\" env PYTHONPATH=\"/pilot-code/src:/pilot-code:$root/runtime\" /workspace/.venv/bin/python \"$root/diagnostic-io/profile-early-fine.py\"\n"
      }
