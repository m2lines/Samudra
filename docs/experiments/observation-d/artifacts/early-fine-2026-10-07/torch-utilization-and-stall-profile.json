  "diagnostic_scripts": {
    "profile-early-fine-stalls.py": "\"\"\"Isolated CPU/CUDA profiling; checkpoint copies cannot enter production.\"\"\"\nimport argparse, cProfile, functools, json, os, pathlib, pstats, time\nimport torch\nfrom samudra.experiments.early_fine_training import EarlyPilot\nfrom samudra.experiments.observation_pilot import atomic_json\narm = pathlib.Path(os.environ['PROFILE_ARM'])\nargs = argparse.Namespace(**json.loads((arm/'manifest.json').read_text())['arguments'])\npilot = EarlyPilot(args)\ninitial = pilot.completed\ncalls = {}\ndef wrap(obj, name, label):\n    original = getattr(obj, name)\n    @functools.wraps(original)\n    def measured(*args, **kwargs):\n        start = time.perf_counter()\n        try:\n            with torch.profiler.record_function(label):\n                return original(*args, **kwargs)\n        finally:\n            calls.setdefault(label, []).append(time.perf_counter()-start)\n    setattr(obj, name, measured)\ntry:\n    for future in pilot.observation_warm: future.result()\n    for _ in range(20): pilot.train_update()\n    for obj, name, label in [(pilot.data,'load','observation_load'), (pilot.early,'sample','early_sample'), (pilot,'checkpoint','checkpoint'), (pilot.optimizer,'step','optimizer_step'), (pilot,'objective','observation_objective'), (pilot,'om4_objective','om4_objective')]:\n        wrap(obj,name,label)\n    cpu = cProfile.Profile()\n    started=time.perf_counter()\n    cpu.enable()\n    for _ in range(24): pilot.train_update()\n    torch.cuda.synchronize()\n    cpu.disable()\n    seconds=time.perf_counter()-started\n    cpu.dump_stats(str(arm/'cpu-profile.pstats'))\n    with (arm/'cpu-profile.txt').open('w') as out:\n        pstats.Stats(cpu,stream=out).sort_stats('cumulative').print_stats(100)\n        pstats.Stats(cpu,stream=out).sort_stats('tottime').print_stats(80)\n    result={'producer':os.environ['SAMUDRA_CODE_COMMIT'],'initial_step':initial,'cpu_profile_final_step':pilot.completed,'cpu_profile_updates':24,'cpu_profile_seconds':seconds,'wall_wrappers':{k:{'count':len(v),'seconds':sum(v)} for k,v in calls.items()},'promote_diagnostic_weights':False}\n    atomic_json(result,arm/'CPU_PROFILE_COMPLETE.json')\n    # Separate short traces for one real update of each task. Instrumented\n    # timing is diagnosis only and cannot satisfy the utilization gate.\n    seen=set()\n    for _ in range(12):\n        task=pilot.schedule.task(pilot.completed)\n        if task=='om4': task='early' if pilot.schedule.counts(pilot.completed)['om4']%2 else 'recent'\n        if task in seen:\n            pilot.train_update()\n            continue\n        with torch.profiler.profile(activities=[torch.profiler.ProfilerActivity.CPU,torch.profiler.ProfilerActivity.CUDA],record_shapes=False,profile_memory=False,with_stack=False) as trace:\n            with torch.profiler.record_function('train_update_'+task): pilot.train_update()\n            torch.cuda.synchronize()\n        trace.export_chrome_trace(str(arm/('trace-'+task+'.json')))\n        (arm/('operators-'+task+'.txt')).write_text(trace.key_averages().table(sort_by='self_cpu_time_total',row_limit=70)+'\\n'+trace.key_averages().table(sort_by='self_device_time_total',row_limit=70))\n        seen.add(task)\n        if len(seen)==3: break\n    if len(seen)!=3: raise RuntimeError('Missing task profile')\n    result.update(final_step=pilot.completed,profiled_tasks=sorted(seen))\n    atomic_json(result,arm/'PROFILE_COMPLETE.json')\n    print(json.dumps(result),flush=True)\nfinally:\n    pilot.early.prefetch.close(); pilot.early.pool.shutdown(wait=True,cancel_futures=True)\n    pilot.observation_warm_pool.shutdown(wait=True,cancel_futures=True)\n    if pilot.wandb: pilot.wandb.finish()\n",
    "profile-early-fine-stalls.sbatch": "#!/bin/bash -l\nset -euo pipefail\nroot=/scratch/jr7309/runs/2026-10-08-early-fine-rtx/recovery-exact-replay\ncode=$root/source/b111057c72373825f1e7b643d1ee8a03daa191c3\nexport SAMUDRA_CODE_COMMIT=b111057c72373825f1e7b643d1ee8a03daa191c3\nexport SAMUDRA_RUNTIME_SHA256=$(sha256sum \"$root/runtime-contract.json\" | cut -d ' ' -f1)\nexport OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1\narms=(U-multitask-early U-multitask-early-latent U-multitask-early-fine U-multitask-early-fine-latent)\narm=${arms[$SLURM_ARRAY_TASK_ID]}\nexport PROFILE_ARM=$root/$arm\nimage=/scratch/jr7309/.apptainer-images/ghcr.io-m2lines-ocean-emulator-physicsnemo-26.05-9cd36b1bdcf4921fb027494afa4157e217818ccd.sif\n# Production and original attempts are read-only. Only independent diagnostic\n# copies and the per-job local cache are writable inside this container.\nsrun apptainer exec --nv --bind \"$code:/pilot-code:ro,/scratch:/scratch:ro,$root/diagnostic-stalls/$arm:$PROFILE_ARM:rw,$SLURM_TMPDIR:$SLURM_TMPDIR\" \"$image\" env PYTHONPATH=\"/pilot-code/src:/pilot-code:$root/runtime\" /workspace/.venv/bin/python \"$root/profile-early-fine-stalls.py\"\n",
    "submit-early-fine-stalls.py": "import hashlib,json,pathlib,shutil,subprocess\nr=pathlib.Path('/scratch/jr7309/runs/2026-10-08-early-fine-rtx/recovery-exact-replay');d=r/'diagnostic-stalls';d.mkdir(exist_ok=False)\ndef sha(p):\n h=hashlib.sha256()\n with p.open('rb') as f:\n  for b in iter(lambda:f.read(8*1024*1024),b''):h.update(b)\n return h.hexdigest()\nrows=[]\nfor arm in ['U-multitask-early','U-multitask-early-fine-latent']:\n src=r/arm; dst=d/arm;dst.mkdir()\n files=[]\n for p in src.iterdir():\n  if p.is_file():\n   q=dst/p.name;shutil.copy2(p,q)\n   before=sha(p);after=sha(q)\n   if before!=after or p.stat().st_ino==q.stat().st_ino:raise RuntimeError('Independent copy failed')\n   files.append({'file':p.name,'sha256':before})\n rows.append({'arm':arm,'files':files})\nreceipt={'copies':rows,'producer':'b111057c72373825f1e7b643d1ee8a03daa191c3','scripts':{n:sha(r/n) for n in ['profile-early-fine-stalls.py','profile-early-fine-stalls.sbatch']},'production_read_only':True,'promote_diagnostic_weights':False}\n(d/'COPIES_VERIFIED.json').write_text(json.dumps(receipt,indent=2)+'\\n')\ncmd=['sbatch','--parsable','--account=torch_pr_347_lzanna','--partition=rtx6000_lzanna','--nodes=1','--ntasks=1','--gres=gpu:1','--cpus-per-task=16','--mem=192G','--array=0,3%2','--time=00:30:00','--chdir=/scratch/jr7309','--job-name=early-fine-stall-profile','--output='+str(r/'logs/stalls-%A_%a.out'),'--error='+str(r/'logs/stalls-%A_%a.err'),str(r/'profile-early-fine-stalls.sbatch')]\njob=subprocess.check_output(cmd,text=True).strip().split(';')[0]\nreceipt.update(job_id=job,command=cmd)\n(d/'submission.json').write_text(json.dumps(receipt,indent=2)+'\\n');print(json.dumps({'job_id':job,'command':cmd}))\n"
